{
  "name": "fefo",
  "version": "0.2.0",
  "private": true,
  "description": "Prototipo P3: trazabilidad de tarimas y control FEFO (PWA + servidor modular + PostgreSQL 16)",
  "workspaces": [
    "servidor",
    "cliente"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.9"
    }
  },
  "scripts": {
    "bd:preparar": "npm run bd:preparar -w servidor -- --reiniciar --clave almacen2026",
    "bd:cargar-sim": "npm run bd:cargar-sim -w servidor -- ../datos/sim_v2",
    "dev": "npm run dev -w servidor",
    "dev:cliente": "npm run dev -w cliente",
    "build": "npm run build -w cliente && npm run build -w servidor",
    "start": "npm start -w servidor",
    "test": "npm test -w servidor && npm test -w cliente",
    "e2e": "npx -w cliente playwright test",
    "rendimiento": "npm run rendimiento -w servidor"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
