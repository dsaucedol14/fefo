<%
// Campo de escaneo: acepta lector de código (teclado), captura manual o la cámara del teléfono.
// Parámetros: nombre, etiqueta, valor, ayuda, autofocus, enviar (envía el formulario al escanear), id
const idCampo = locals.id || ('esc-' + nombre);
%>
<div class="campo">
  <label for="<%= idCampo %>"><%= etiqueta %></label>
  <div class="escaner">
    <input id="<%= idCampo %>" name="<%= nombre %>" value="<%= locals.valor || '' %>" data-escaner
           <%= locals.enviar ? 'data-enviar' : '' %> <%= locals.autofocus ? 'autofocus' : '' %>
           autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text"
           placeholder="<%= locals.placeholder || 'Escanea o escribe el código' %>">
    <button type="button" class="camara secundario" data-camara="<%= idCampo %>" title="Escanear con la cámara" aria-label="Escanear con la cámara"><%- include('icono', { nombre: 'camara' }) %></button>
  </div>
  <% if (locals.ayuda) { %><div class="ayuda"><%= ayuda %></div><% } %>
</div>
