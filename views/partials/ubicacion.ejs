<%
// Muestra una posición con su profundidad y las tarimas que la bloquean (RF-07, C1).
// Parámetros: pos { id_posicion, tipo, profundidad }, bloqueadores [ { id_tarima, id_posicion } ]
%>
<% if (!pos || !pos.id_posicion) { %>
  <span class="nivel nivel-ALTO">Por ubicar</span>
<% } else { %>
  <span class="posicion"><%= pos.id_posicion %></span>
  <% if (pos.tipo === 'PISO') { %>
    <span class="tenue chico">· profundidad <%= pos.profundidad %><%= pos.profundidad === 1 ? ' (frente)' : '' %></span>
  <% } %>
  <% if (bloqueadores && bloqueadores.length) { %>
    <div class="bloqueo chico">Bloqueado por <%= bloqueadores.length %> <%= bloqueadores.length === 1 ? 'tarima' : 'tarimas' %>:
      <% bloqueadores.forEach((b, i) => { %><%= i ? ', ' : '' %><a href="/tarimas/<%= encodeURIComponent(b.id_tarima) %>" class="mono"><%= b.id_tarima %></a> (<%= b.id_posicion %>)<% }) %></div>
  <% } %>
<% } %>
