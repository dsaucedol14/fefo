<%- include('../partials/encabezado') %>
<div class="encabezado"><div><h1>Productos</h1><p class="tenue"><%= productos.length %> en el catálogo. Para editar uno, escribe su SKU en el formulario.</p></div></div>
<%- include('../partials/menu-admin') %>
<div class="rejilla">
  <section class="panel" style="grid-column: span 2">
    <div class="tabla-envoltura">
    <table class="tabla chico">
      <thead><tr><th>SKU</th><th>Producto</th><th>Categoría</th><th class="derecha">Vida útil</th><th>Frío</th><th class="derecha">Costo/caja</th><th>Estado</th></tr></thead>
      <tbody>
      <% for (const p of productos) { %>
        <tr><td class="mono"><%= p.sku %></td><td><%= p.nombre %></td><td><%= p.categoria %></td><td class="derecha"><%= p.vida_util_dias ?? '' %></td>
          <td><%= p.requiere_frio ? 'Sí' : '' %></td><td class="derecha"><%= f.pesos(p.costo_caja) %></td><td><%= p.activo ? 'Activo' : 'Inactivo' %></td></tr>
      <% } %>
      </tbody>
    </table>
    </div>
  </section>
  <section class="panel">
    <h2>Agregar o editar</h2>
    <form method="post" action="/admin/productos">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="campo"><label for="p-sku">SKU o GTIN</label><input id="p-sku" name="sku" maxlength="14" required class="mono"></div>
      <div class="campo"><label for="p-nombre">Nombre</label><input id="p-nombre" name="nombre" maxlength="120" required></div>
      <div class="campo"><label for="p-cat">Categoría</label><select id="p-cat" name="categoria_id" required><% for (const c of categorias) { %><option value="<%= c.id %>"><%= c.nombre %></option><% } %></select></div>
      <div class="fila-form">
        <div class="campo"><label for="p-vu">Vida útil (días)</label><input id="p-vu" name="vida_util_dias" type="number" min="0"></div>
        <div class="campo"><label for="p-costo">Costo por caja</label><input id="p-costo" name="costo_caja" type="number" min="0" step="0.01"></div>
      </div>
      <label class="opcion"><input type="checkbox" name="requiere_frio" value="1"> Requiere frío (solo zona de cámara)</label>
      <div class="campo"><label for="p-activo">Estado</label><select id="p-activo" name="activo"><option value="1">Activo</option><option value="0">Inactivo</option></select></div>
      <button type="submit">Guardar producto</button>
    </form>
  </section>
</div>
<%- include('../partials/pie') %>
