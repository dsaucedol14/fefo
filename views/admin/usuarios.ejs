<%- include('../partials/encabezado') %>
<div class="encabezado"><div><h1>Usuarios</h1><p class="tenue">Solo se guardan nombre, usuario y rol (RNF-09).</p></div></div>
<%- include('../partials/menu-admin') %>
<% if (error) { %><div class="aviso error" role="alert"><%= error %></div><% } %>
<div class="rejilla">
  <section class="panel">
    <h2>Usuarios registrados</h2>
    <div class="tarjetas">
    <% for (const u of usuarios) { %>
      <form method="post" action="/admin/usuarios/<%= u.id %>" class="tarjeta">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <h3><%= u.nombre %> <span class="mono tenue chico"><%= u.usuario %></span> <% if (!u.activo) { %><span class="nivel">Inactivo</span><% } %></h3>
        <div class="fila-form">
          <div class="campo"><label>Rol</label><select name="rol"><% for (const [k, v] of Object.entries(ROLES)) { %><option value="<%= k %>" <%= u.rol === k ? 'selected' : '' %>><%= v %></option><% } %></select></div>
          <div class="campo"><label>Estado</label><select name="activo"><option value="1" <%= u.activo ? 'selected' : '' %>>Activo</option><option value="0" <%= !u.activo ? 'selected' : '' %>>Inactivo</option></select></div>
          <div class="campo"><label>Nueva contraseña</label><input name="password" type="password" minlength="8" autocomplete="new-password" placeholder="Sin cambio"></div>
        </div>
        <div class="chico tenue">Aviso de privacidad: <%= u.aviso_aceptado_en ? f.fechaHora(u.aviso_aceptado_en) : 'pendiente' %></div>
        <button type="submit" class="secundario chico" style="margin-top:8px">Guardar</button>
      </form>
    <% } %>
    </div>
  </section>
  <section class="panel">
    <h2>Nuevo usuario</h2>
    <form method="post" action="/admin/usuarios">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="campo"><label for="n-usuario">Usuario</label><input id="n-usuario" name="usuario" value="<%= form.usuario || '' %>" autocapitalize="none" pattern="[a-z0-9._\-]{3,30}" required><div class="ayuda">Para el estudio usa códigos (alm01, sup01) en lugar de nombres reales.</div></div>
      <div class="campo"><label for="n-nombre">Nombre</label><input id="n-nombre" name="nombre" value="<%= form.nombre || '' %>" maxlength="120" required></div>
      <div class="campo"><label for="n-rol">Rol</label><select id="n-rol" name="rol"><% for (const [k, v] of Object.entries(ROLES)) { %><option value="<%= k %>" <%= form.rol === k ? 'selected' : '' %>><%= v %></option><% } %></select></div>
      <div class="campo"><label for="n-password">Contraseña inicial</label><input id="n-password" name="password" type="password" minlength="8" autocomplete="new-password" required></div>
      <button type="submit">Crear usuario</button>
    </form>
    <h3 style="margin-top:18px">Qué puede hacer cada rol</h3>
    <ul class="chico">
      <li><strong>Almacenista:</strong> recibir, ubicar y mover, surtir, localizar y ver alertas. No autoriza nada.</li>
      <li><strong>Supervisor:</strong> además crea pedidos, autoriza lotes con poca vida remanente, registra caducidad efectiva, ve la bitácora y edita productos y umbrales.</li>
      <li><strong>Administración:</strong> todo lo anterior y los usuarios.</li>
    </ul>
  </section>
</div>
<%- include('../partials/pie') %>
