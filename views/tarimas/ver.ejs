<%- include('../partials/encabezado') %>
<div class="encabezado">
  <div>
    <h1>Tarima <span class="mono"><%= t.id_tarima %></span></h1>
    <p class="tenue">Recibida el <%= f.fechaHora(t.fecha_recepcion) %><%= t.estado === 'VACIA' ? ' · ya salió del almacén (vacía)' : '' %></p>
  </div>
  <div class="acciones no-imprimir" style="margin:0">
    <a class="boton secundario" href="/tarimas/<%= encodeURIComponent(t.id_tarima) %>/etiqueta"><%- include('../partials/icono', { nombre: 'imprimir' }) %> Etiqueta</a>
    <% if (t.estado === 'ACTIVA') { %><a class="boton" href="/mover?tarima=<%= encodeURIComponent(t.id_tarima) %>"><%- include('../partials/icono', { nombre: 'mover' }) %> <%= t.id_posicion ? 'Mover' : 'Ubicar ahora' %></a><% } %>
  </div>
</div>

<div class="rejilla">
  <section class="panel">
    <h2>Ubicación</h2>
    <% if (t.estado === 'ACTIVA') { %>
      <%- include('../partials/ubicacion', { pos: t, bloqueadores }) %>
      <% if (!t.id_posicion) { %><p class="tenue chico">No aparece como disponible para surtir hasta que se escanee su posición (RF-06).</p><% } %>
      <% if (t.requiereFrio) { %><p class="chico"><span class="nivel nivel-PREVENTIVO">Requiere frío</span> solo puede ir a cámara fría.</p><% } %>
    <% } else { %><p class="tenue">Sin ubicación.</p><% } %>
  </section>
  <section class="panel" style="text-align:center">
    <div style="max-width:180px;margin:0 auto"><%- qr %></div>
    <div class="mono"><%= t.id_tarima %></div>
  </section>
</div>

<section class="panel">
  <h2>Lotes en la tarima</h2>
  <div class="tabla-envoltura">
  <table class="tabla">
    <thead><tr><th>Producto</th><th>Lote</th><th>Caducidad</th><th>Restan</th><th class="derecha">Cajas</th><% if (usuario.esSupervisor) { %><th class="no-imprimir"></th><% } %></tr></thead>
    <tbody>
    <% for (const l of t.lotes) { %>
      <tr>
        <td><%= l.producto %><div class="tenue chico mono"><%= l.sku %></div></td>
        <td class="mono"><%= l.num_lote %></td>
        <td class="nowrap"><%= f.fecha(l.caducidad_efectiva || l.fecha_caducidad) %>
          <% if (l.caducidad_efectiva) { %><div class="chico tenue">efectiva; impresa <%= f.fecha(l.fecha_caducidad) %> · <%= l.motivo_caducidad_efectiva %></div><% } %></td>
        <td class="nowrap"><%= f.dias(l.d) %></td>
        <td class="derecha"><%= l.cajas %></td>
        <% if (usuario.esSupervisor) { %>
        <td class="no-imprimir">
          <% if (l.cajas > 0 && !l.caducidad_efectiva) { %>
          <details><summary class="chico">Caducidad efectiva</summary>
            <form method="post" action="/lotes/<%= l.id_lote %>/caducidad-efectiva" style="min-width:220px">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="volver" value="/tarimas/<%= t.id_tarima %>">
              <div class="campo"><label>Nueva caducidad</label><input type="date" name="caducidad_efectiva" max="<%= l.fecha_caducidad %>" required></div>
              <div class="campo"><label>Justificación</label><input name="motivo" maxlength="200" placeholder="Ruptura de cadena de frío…" required></div>
              <button type="submit" class="chico">Registrar</button>
            </form>
          </details>
          <% } %>
        </td>
        <% } %>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
</section>

<section class="panel">
  <h2>Movimientos</h2>
  <div class="tabla-envoltura">
  <table class="tabla chico">
    <thead><tr><th>Fecha</th><th>Tipo</th><th>Lote</th><th class="derecha">Cajas</th><th>Origen → destino</th><th>FEFO</th><th>Usuario</th></tr></thead>
    <tbody>
    <% for (const m of movimientos) { %>
      <tr>
        <td class="nowrap"><%= f.fechaHora(m.fecha_hora) %></td>
        <td><%= f.tipoMov(m.tipo) %></td>
        <td class="mono"><%= m.num_lote || '' %></td>
        <td class="derecha"><%= m.cajas || '' %></td>
        <td class="mono"><%= m.pos_origen || '' %><%= (m.pos_origen || m.pos_destino) ? ' → ' : '' %><%= m.pos_destino || '' %></td>
        <td><%= m.conforme_fefo === 1 ? 'Conforme' : m.conforme_fefo === 0 ? ('Excepción: ' + (MOTIVOS[m.motivo_excepcion] || m.motivo_excepcion)) : '' %></td>
        <td><%= m.usuario || (m.origen_dato === 'IMPORTADO' ? 'importado' : '') %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
</section>
<%- include('../partials/pie') %>
