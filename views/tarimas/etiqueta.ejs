<%- include('../partials/encabezado') %>
<div class="encabezado no-imprimir">
  <div><h1>Etiqueta de tarima</h1><p class="tenue">Imprímela en papel adhesivo y pégala en un costado visible de la tarima.</p></div>
  <div class="acciones" style="margin:0">
    <a class="boton secundario" href="/tarimas/<%= encodeURIComponent(t.id_tarima) %>">Volver a la tarima</a>
    <button type="button" onclick="window.print()"><%- include('../partials/icono', { nombre: 'imprimir' }) %> Imprimir</button>
  </div>
</div>
<div class="etiqueta-tarima">
  <div class="qr"><%- qr %></div>
  <div class="id"><%= t.id_tarima %></div>
  <table>
    <tr><th>Producto</th><th>Lote</th><th>Cad.</th><th>Cajas</th></tr>
    <% for (const l of t.lotes) { %>
    <tr><td><%= l.producto %></td><td><%= l.num_lote %></td><td><%= f.fecha(l.caducidad_efectiva || l.fecha_caducidad) %></td><td><%= l.cajas %></td></tr>
    <% } %>
  </table>
  <div style="font-size:9pt;margin-top:2mm">Recibida <%= f.fechaHora(t.fecha_recepcion) %> · <%= usuario.empresa %></div>
</div>
<%- include('../partials/pie') %>
