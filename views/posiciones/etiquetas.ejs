<%- include('../partials/encabezado') %>
<div class="encabezado no-imprimir">
  <div><h1>Etiquetas de posiciones</h1><p class="tenue">Etiquetas de 62 × 40 mm con QR. Pégalas en el rack o en el piso al frente de cada lugar.</p></div>
</div>
<form method="get" action="/posiciones/etiquetas" class="panel no-imprimir" style="max-width:520px">
  <div class="fila-form">
    <div class="campo"><label for="zona">Zona</label>
      <select id="zona" name="zona" onchange="this.form.submit()">
        <option value="">Elige la zona</option>
        <% for (const z of zonas) { %><option value="<%= z.zona %>" <%= z.zona === zona ? 'selected' : '' %>>Zona <%= z.zona %></option><% } %>
      </select>
    </div>
  </div>
  <% if (posiciones.length) { %><button type="button" onclick="window.print()"><%- include('../partials/icono', { nombre: 'imprimir' }) %> Imprimir <%= posiciones.length %> etiquetas</button><% } %>
</form>
<div class="hoja-etiquetas">
  <% for (const p of posiciones) { %>
  <div class="etiqueta-pos"><%- p.qr %><div><div class="codigo"><%= p.id_posicion %></div><div style="font-size:8pt"><%= p.tipo === 'PISO' ? 'Piso · prof. ' + p.profundidad : 'Rack' %></div></div></div>
  <% } %>
</div>
<%- include('../partials/pie') %>
