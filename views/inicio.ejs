<%- include('partials/encabezado') %>
<div class="encabezado">
  <div><h1><%= usuario.empresa %></h1><p class="tenue"><%= f.fecha(hoy) %> · <%= ocupacion.ocupadas || 0 %> de <%= ocupacion.total %> posiciones ocupadas</p></div>
</div>

<nav class="mosaicos" aria-label="Tareas">
  <a class="mosaico" href="/recepcion"><%- include('partials/icono', { nombre: 'recibir' }) %>Recibir tarima<small>ID, etiqueta y lotes</small></a>
  <a class="mosaico" href="/mover"><%- include('partials/icono', { nombre: 'mover' }) %>Ubicar o mover<small><%= porUbicar %> por ubicar</small></a>
  <a class="mosaico" href="/pedidos"><%- include('partials/icono', { nombre: 'surtir' }) %>Surtir pedido<small><%= pedidos.length %> abiertos</small></a>
  <a class="mosaico" href="/localizar"><%- include('partials/icono', { nombre: 'buscar' }) %>Localizar<small>lote, producto o tarima</small></a>
  <a class="mosaico" href="/alertas"><%- include('partials/icono', { nombre: 'alerta' }) %>Alertas<small>caducidad por categoría</small></a>
  <a class="mosaico" href="/posiciones"><%- include('partials/icono', { nombre: 'mapa' }) %>Mapa<small>ocupación y riesgo</small></a>
</nav>

<div class="rejilla">
  <section class="panel">
    <h2>Alertas de caducidad</h2>
    <div class="cifras">
      <% for (const n of ['VENCIDO', 'CRITICO', 'ALTO', 'PREVENTIVO', 'ROTACION']) { %>
        <a class="cifra" href="/alertas?nivel=<%= n %>"><span class="nivel nivel-<%= n %>"><%= f.nivel(n) %></span><b><%= niveles[n] %></b><span class="tenue chico">lotes</span></a>
      <% } %>
    </div>
    <p class="tenue chico" style="margin-bottom:0">«Riesgo por rotación» cuenta los lotes que aún no entran al umbral pero no alcanzarán a salir al ritmo actual.</p>
  </section>
  <section class="panel">
    <h2>Pedidos abiertos</h2>
    <% if (!pedidos.length) { %><p class="tenue">No hay pedidos abiertos.</p><% } %>
    <div class="tarjetas">
      <% for (const p of pedidos) { %>
        <a class="tarjeta" href="/pedidos/<%= p.id %>" style="text-decoration:none;color:inherit"><strong class="mono"><%= p.folio %></strong> <span class="tenue"><%= p.cliente || '' %></span></a>
      <% } %>
    </div>
    <% if (usuario.esSupervisor) { %><div class="acciones"><a class="boton secundario" href="/pedidos/nuevo">Nuevo pedido</a></div><% } %>
  </section>
</div>
<%- include('partials/pie') %>
