<%- include('../partials/encabezado') %>
<div class="encabezado">
  <div><h1>Pedidos</h1><p class="tenue">Cada pedido genera su lista de surtido FEFO.</p></div>
  <% if (usuario.esSupervisor) { %><a class="boton" href="/pedidos/nuevo">Nuevo pedido</a><% } %>
</div>
<% if (!pedidos.length) { %><div class="aviso info">Todavía no hay pedidos.</div><% } %>
<div class="tabla-envoltura panel" style="padding:0 8px">
<table class="tabla">
  <thead><tr><th>Folio</th><th>Cliente</th><th>Estado</th><th class="derecha">Cajas</th><th class="solo-escritorio">Creado</th></tr></thead>
  <tbody>
  <% for (const p of pedidos) { %>
    <tr>
      <td><a class="mono" href="/pedidos/<%= p.id %>"><%= p.folio %></a></td>
      <td><%= p.cliente || '' %></td>
      <td><span class="nivel <%= p.estado === 'ABIERTO' ? 'nivel-PREVENTIVO' : p.estado === 'CERRADO' ? 'nivel-OK' : '' %>"><%= p.estado === 'ABIERTO' ? 'Abierto' : p.estado === 'CERRADO' ? 'Surtido' : 'Cancelado' %></span></td>
      <td class="derecha nowrap"><%= p.surtidas || 0 %> / <%= p.cajas || 0 %></td>
      <td class="solo-escritorio nowrap"><%= f.fechaHora(p.creado_en) %></td>
    </tr>
  <% } %>
  </tbody>
</table>
</div>
<%- include('../partials/pie') %>
