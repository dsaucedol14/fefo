<%- include('partials/encabezado') %>
<div class="acceso">
  <div class="marca-grande"><%- include('partials/icono', { nombre: 'tarima' }) %> FEFO Tarimas</div>
  <div class="panel">
    <h1>Iniciar sesión</h1>
    <p class="tenue chico">Trazabilidad de tarimas y control FEFO · prototipo académico</p>
    <% if (locals.error) { %><div class="aviso error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="campo">
        <label for="usuario">Usuario</label>
        <input id="usuario" name="usuario" value="<%= usuarioEscrito %>" autocomplete="username" autocapitalize="none" required autofocus>
      </div>
      <div class="campo">
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="grande">Entrar</button>
    </form>
  </div>
</div>
<%- include('partials/pie') %>
