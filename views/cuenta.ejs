<%- include('partials/encabezado') %>
<div class="encabezado"><div><h1>Mi cuenta</h1><p class="tenue"><%= usuario.nombre %> · <span class="mono"><%= usuario.usuario %></span> · <%= usuario.nombreRol %></p></div></div>
<div class="rejilla">
  <div class="panel">
    <h2>Cambiar contraseña</h2>
    <form method="post" action="/cuenta/password">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="campo"><label for="actual">Contraseña actual</label><input id="actual" name="actual" type="password" autocomplete="current-password" required></div>
      <div class="campo"><label for="nueva">Nueva contraseña</label><input id="nueva" name="nueva" type="password" minlength="8" autocomplete="new-password" required><div class="ayuda">Al menos 8 caracteres.</div></div>
      <div class="campo"><label for="confirmacion">Confirmar</label><input id="confirmacion" name="confirmacion" type="password" minlength="8" autocomplete="new-password" required></div>
      <button type="submit">Guardar contraseña</button>
    </form>
  </div>
  <div class="panel">
    <h2>Privacidad</h2>
    <p>El sistema guarda solo tu nombre, tu usuario y tu rol.</p>
    <a class="boton secundario" href="/aviso-privacidad">Ver aviso de privacidad</a>
  </div>
</div>
<%- include('partials/pie') %>
