# Copia este archivo como .env y ajusta los valores.

# Puerto web (http://localhost:3200)
PORT=3200
# Puerto HTTPS con certificado autofirmado: necesario para usar la cámara del teléfono desde la red local.
# Déjalo vacío para no abrirlo.
HTTPS_PORT=3443

# MySQL (Laragon: usuario root sin contraseña)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fefo_tarimas

# Cadena larga y aleatoria para firmar las sesiones. Cámbiala.
SESSION_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria

# Primer usuario de administración: se crea al arrancar si no existe ninguno activo.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=fefo-dev-2026

# Fecha de operación fija (AAAA-MM-DD) para trabajar con los datos sintéticos del Anexo C.
# Déjala vacía en el piloto real para usar la fecha del equipo.
FECHA_OPERACION=

# Umbral de alerta por omisión cuando una categoría no tiene parámetros (RN-07)
UMBRAL_OMISION_DIAS=30
