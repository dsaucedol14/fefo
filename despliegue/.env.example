# Copia este archivo como .env (en esta carpeta) y cambia las contraseñas.
PG_PASSWORD=cambia-esta-contrasena-del-superusuario
APP_DB_PASSWORD=cambia-esta-contrasena-de-la-aplicacion
# IP fija de la PC de oficina en la red del almacén: el certificado HTTPS se emite para ella
FEFO_HOST=192.168.1.50
# Puertos publicados (cámbialos si 80 o 443 ya están ocupados en la PC)
HTTP_PORT=80
HTTPS_PORT=443
